# Copy to .env (gitignored) for local development.
NODE_ENV=development
PORT=4200
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/cb
# 32 random bytes, base64: openssl rand -base64 32
MASTER_KEY=
SERVER_SECRET=
DASHBOARD_URL=http://localhost:4201
# Address payment providers reach for webhooks (a tunnel such as cloudflared in development).
# PUBLIC_URL=https://your-tunnel.example
COOKIE_SECURE=false
# OQ11: plain http to private addresses (local dev). Set false for hosted, multi-tenant deployments.
# ALLOW_PRIVATE_HTTP_UPSTREAMS=true
