[
  {
    "id": "openai",
    "name": "OpenAI",
    "category": "AI",
    "group": "ai",
    "kind": "http",
    "description": "OpenAI SDKs read OPENAI_BASE_URL, so traffic goes through a local listener.",
    "defaults": {
      "upstreamUrl": "https://api.openai.com",
      "authScheme": "bearer",
      "fakePrefix": "sk-cb-",
      "testPath": "/v1/models",
      "basePath": "/v1",
      "redirectHosts": [
        "api.openai.com:443"
      ]
    },
    "secretPlaceholder": "sk-proj-\u2026",
    "variables": [
      {
        "key": "OPENAI_API_KEY",
        "field": "key"
      },
      {
        "key": "OPENAI_BASE_URL",
        "field": "baseUrl"
      }
    ]
  },
  {
    "id": "anthropic",
    "name": "Anthropic",
    "category": "AI",
    "group": "ai",
    "kind": "http",
    "description": "Anthropic SDKs send the key in x-api-key and read ANTHROPIC_BASE_URL.",
    "defaults": {
      "upstreamUrl": "https://api.anthropic.com",
      "authScheme": "x-api-key",
      "fakePrefix": "sk-ant-cb-",
      "testPath": "/v1/models",
      "basePath": "",
      "redirectHosts": [
        "api.anthropic.com:443"
      ]
    },
    "secretPlaceholder": "sk-ant-\u2026",
    "variables": [
      {
        "key": "ANTHROPIC_API_KEY",
        "field": "key"
      },
      {
        "key": "ANTHROPIC_BASE_URL",
        "field": "baseUrl"
      }
    ]
  },
  {
    "id": "gemini",
    "name": "Google Gemini",
    "category": "AI",
    "group": "ai",
    "kind": "http",
    "description": "Gemini SDKs send the key in x-goog-api-key; generativelanguage.googleapis.com is redirected.",
    "defaults": {
      "upstreamUrl": "https://generativelanguage.googleapis.com",
      "authScheme": "header",
      "authHeader": "x-goog-api-key",
      "fakePrefix": "AIzaCb",
      "testPath": "/v1beta/models",
      "basePath": "",
      "redirectHosts": [
        "generativelanguage.googleapis.com:443"
      ]
    },
    "secretPlaceholder": "AIza\u2026",
    "variables": [
      {
        "key": "GEMINI_API_KEY",
        "field": "key"
      }
    ]
  },
  {
    "id": "groq",
    "name": "Groq",
    "category": "AI",
    "group": "ai",
    "kind": "http",
    "description": "OpenAI-compatible; api.groq.com is redirected.",
    "defaults": {
      "upstreamUrl": "https://api.groq.com",
      "authScheme": "bearer",
      "fakePrefix": "gsk_cb_",
      "testPath": "/openai/v1/models",
      "basePath": "/openai/v1",
      "redirectHosts": [
        "api.groq.com:443"
      ]
    },
    "secretPlaceholder": "gsk_\u2026",
    "variables": [
      {
        "key": "GROQ_API_KEY",
        "field": "key"
      }
    ]
  },
  {
    "id": "mistral",
    "name": "Mistral",
    "category": "AI",
    "group": "ai",
    "kind": "http",
    "description": "api.mistral.ai is redirected.",
    "defaults": {
      "upstreamUrl": "https://api.mistral.ai",
      "authScheme": "bearer",
      "fakePrefix": "mistral_cb_",
      "testPath": "/v1/models",
      "basePath": "/v1",
      "redirectHosts": [
        "api.mistral.ai:443"
      ]
    },
    "secretPlaceholder": "the API key",
    "variables": [
      {
        "key": "MISTRAL_API_KEY",
        "field": "key"
      }
    ]
  },
  {
    "id": "openrouter",
    "name": "OpenRouter",
    "category": "AI",
    "group": "ai",
    "kind": "http",
    "description": "OpenAI-compatible; openrouter.ai is redirected.",
    "defaults": {
      "upstreamUrl": "https://openrouter.ai",
      "authScheme": "bearer",
      "fakePrefix": "sk-or-cb-",
      "testPath": "/api/v1/key",
      "basePath": "/api/v1",
      "redirectHosts": [
        "openrouter.ai:443"
      ]
    },
    "secretPlaceholder": "sk-or-\u2026",
    "variables": [
      {
        "key": "OPENROUTER_API_KEY",
        "field": "key"
      }
    ]
  },
  {
    "id": "supabase",
    "name": "Supabase",
    "category": "Database",
    "kind": "http",
    "description": "Your project URL; the secret key is sent as apikey and Bearer. The publishable key passes through unchanged.",
    "defaults": {
      "upstreamUrl": "https://<project-ref>.supabase.co",
      "authScheme": "header",
      "authHeader": "apikey",
      "fakePrefix": "sb_secret_cb_",
      "testPath": "/rest/v1/",
      "basePath": "",
      "passOtherKeys": true
    },
    "secretPlaceholder": "sb_secret_\u2026",
    "variables": [
      {
        "key": "SUPABASE_SECRET_KEY",
        "field": "key"
      }
    ]
  },
  {
    "id": "stripe",
    "name": "Stripe",
    "category": "Payments",
    "kind": "http",
    "description": "The Stripe SDK has a fixed host, so api.stripe.com is redirected (Layer 2).",
    "defaults": {
      "upstreamUrl": "https://api.stripe.com",
      "authScheme": "bearer",
      "fakePrefix": "sk_test_cb_",
      "testPath": "/v1/balance",
      "basePath": "",
      "redirectHosts": [
        "api.stripe.com:443"
      ]
    },
    "secretPlaceholder": "sk_live_\u2026 or sk_test_\u2026",
    "variables": [
      {
        "key": "STRIPE_SECRET_KEY",
        "field": "key"
      }
    ]
  },
  {
    "id": "razorpay",
    "name": "Razorpay",
    "category": "Payments",
    "kind": "http",
    "description": "Basic auth: the key id stays a plain variable, the key secret is brokered.",
    "defaults": {
      "upstreamUrl": "https://api.razorpay.com",
      "authScheme": "basic-password",
      "fakePrefix": "cb_",
      "testPath": "/v1/payments?count=1",
      "basePath": "",
      "redirectHosts": [
        "api.razorpay.com:443"
      ]
    },
    "secretPlaceholder": "Razorpay key secret",
    "variables": [
      {
        "key": "RAZORPAY_KEY_SECRET",
        "field": "key"
      }
    ],
    "plainVariables": [
      {
        "key": "RAZORPAY_KEY_ID",
        "hint": "Your rzp_\u2026 key id (not secret)"
      }
    ]
  },
  {
    "id": "google-oauth",
    "name": "Google sign-in",
    "category": "Auth",
    "group": "oauth",
    "kind": "oauth",
    "description": "The client secret is swapped at Google's token endpoint; the client id stays plain.",
    "defaults": {
      "tokenUrl": "https://oauth2.googleapis.com/token"
    },
    "secretPlaceholder": "GOCSPX-\u2026",
    "variables": [
      {
        "key": "GOOGLE_CLIENT_SECRET",
        "field": "clientSecret"
      }
    ],
    "plainVariables": [
      {
        "key": "GOOGLE_CLIENT_ID",
        "hint": "\u2026apps.googleusercontent.com"
      }
    ]
  },
  {
    "id": "github-oauth",
    "name": "GitHub sign-in",
    "category": "Auth",
    "group": "oauth",
    "kind": "oauth",
    "description": "The client secret is swapped at GitHub's token endpoint.",
    "defaults": {
      "tokenUrl": "https://github.com/login/oauth/access_token"
    },
    "secretPlaceholder": "GitHub OAuth client secret",
    "variables": [
      {
        "key": "GITHUB_CLIENT_SECRET",
        "field": "clientSecret"
      }
    ],
    "plainVariables": [
      {
        "key": "GITHUB_CLIENT_ID",
        "hint": "Iv1.\u2026"
      }
    ]
  },
  {
    "id": "firebase",
    "name": "Firebase Admin",
    "category": "Push",
    "kind": "google-sa",
    "description": "Firebase Admin / FCM with a per-device fake service-account key.",
    "defaults": {},
    "secretPlaceholder": "Service-account JSON",
    "variables": [
      {
        "key": "FIREBASE_PROJECT_ID",
        "field": "projectId"
      },
      {
        "key": "FIREBASE_CLIENT_EMAIL",
        "field": "clientEmail"
      },
      {
        "key": "FIREBASE_PRIVATE_KEY",
        "field": "privateKey"
      }
    ]
  },
  {
    "id": "apns",
    "name": "Apple Push",
    "category": "Push",
    "kind": "apns",
    "description": "Token-based APNs; apps sign with a fake .p8 that the gateway re-signs.",
    "defaults": {},
    "secretPlaceholder": "-----BEGIN PRIVATE KEY-----",
    "variables": [
      {
        "key": "APNS_KEY",
        "field": "key"
      },
      {
        "key": "APNS_KEY_ID",
        "field": "keyId"
      },
      {
        "key": "APNS_TEAM_ID",
        "field": "teamId"
      }
    ]
  },
  {
    "id": "aws-s3",
    "name": "AWS S3",
    "category": "Storage",
    "kind": "aws",
    "description": "Requests and presigned URLs are re-signed with the real keys.",
    "defaults": {
      "region": "us-east-1",
      "endpoint": "https://s3.us-east-1.amazonaws.com"
    },
    "secretPlaceholder": "AWS secret access key",
    "variables": [
      {
        "key": "AWS_ACCESS_KEY_ID",
        "field": "accessKeyId"
      },
      {
        "key": "AWS_SECRET_ACCESS_KEY",
        "field": "secretAccessKey"
      },
      {
        "key": "AWS_ENDPOINT_URL",
        "field": "endpoint"
      },
      {
        "key": "AWS_REGION",
        "field": "region"
      }
    ]
  },
  {
    "id": "cloudflare-r2",
    "name": "Cloudflare R2",
    "category": "Storage",
    "kind": "aws",
    "description": "S3-compatible; replace <account-id> in the endpoint.",
    "defaults": {
      "region": "auto",
      "endpoint": "https://<account-id>.r2.cloudflarestorage.com"
    },
    "secretPlaceholder": "R2 secret access key",
    "variables": [
      {
        "key": "AWS_ACCESS_KEY_ID",
        "field": "accessKeyId"
      },
      {
        "key": "AWS_SECRET_ACCESS_KEY",
        "field": "secretAccessKey"
      },
      {
        "key": "AWS_ENDPOINT_URL",
        "field": "endpoint"
      },
      {
        "key": "AWS_REGION",
        "field": "region"
      }
    ]
  },
  {
    "id": "sendgrid-smtp",
    "name": "SendGrid (SMTP)",
    "category": "Email",
    "kind": "smtp",
    "description": "SMTP with the API key as password (user is literally \"apikey\").",
    "defaults": {},
    "secretPlaceholder": "smtp://apikey:SG.\u2026@smtp.sendgrid.net:587",
    "variables": [
      {
        "key": "SMTP_HOST",
        "field": "host"
      },
      {
        "key": "SMTP_PORT",
        "field": "port"
      },
      {
        "key": "SMTP_USER",
        "field": "user"
      },
      {
        "key": "SMTP_PASS",
        "field": "password"
      }
    ]
  },
  {
    "id": "postgres",
    "name": "PostgreSQL",
    "category": "Database",
    "kind": "postgres",
    "description": "Neon, Supabase, RDS or self-hosted Postgres.",
    "defaults": {},
    "secretPlaceholder": "postgresql://user:password@host:5432/db?sslmode=require",
    "variables": [
      {
        "key": "DATABASE_URL",
        "field": "url"
      }
    ]
  },
  {
    "id": "mongodb",
    "name": "MongoDB",
    "category": "Database",
    "kind": "mongodb",
    "description": "Single-host MongoDB with SCRAM-SHA-256 (mongodb+srv later).",
    "defaults": {},
    "secretPlaceholder": "mongodb://user:password@host:27017/db?authSource=admin",
    "variables": [
      {
        "key": "MONGODB_URI",
        "field": "url"
      }
    ]
  },
  {
    "id": "redis",
    "name": "Redis",
    "category": "Database",
    "kind": "redis",
    "description": "Redis with a password or ACL user.",
    "defaults": {},
    "secretPlaceholder": "redis://user:password@host:6379/0",
    "variables": [
      {
        "key": "REDIS_URL",
        "field": "url"
      }
    ]
  }
]
